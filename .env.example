# Copy this file to .env and fill in your own values.
# .env is gitignored; never commit it.

# Issuer ID from https://pay.google.com/business/console
WALLET_ISSUER_ID=

# Path to the service account key downloaded from Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Public URL of output/hero.png once it's pushed
HERO_URL=https://raw.githubusercontent.com/VS3hdav3/wallet-pass/main/output/hero.png
